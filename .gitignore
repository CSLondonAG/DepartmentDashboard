# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Streamlit logs and cache
.streamlit/
*.log

# Environment files
.env
.venv/
venv/
env/
*.env

# Data files (if they shouldn't be committed)
*.xlsx
*.json

# IDE/editor settings
.vscode/
.idea/
*.swp

# System files
.DS_Store
Thumbs.db

# Jupyter notebooks (optional)
*.ipynb_checkpoints/

# Production data exports are NEVER committed (see docs/data-governance.md).
# Synthetic fixtures live under tests/fixtures/ and are not matched by these root-anchored rules.
/*.csv
/data_snapshots/
/snapshots/
.streamlit/secrets.toml
manifest.json
